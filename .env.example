# ============================================================================
# CATÁLOGO DIGITAL + WHATSAPP — VARIABLES DE ENTORNO
# Copia este archivo como ".env" y completa con tus valores reales.
# NUNCA subas el archivo ".env" real a git.
# ============================================================================

# --- Base de datos (Supabase → Project Settings → Database) ----------------
# Usa la cadena "Connection pooling" (puerto 6543) para DATABASE_URL: es la
# que usa la app en producción (serverless-friendly).
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Usa la cadena "Direct connection" (puerto 5432) para DIRECT_URL: Prisma
# Migrate la necesita porque el pooler no soporta todas las operaciones DDL.
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."          # segura para el navegador
SUPABASE_SERVICE_ROLE_KEY="eyJ..."              # SECRETA — solo servidor, nunca exponer al cliente

# --- Sitio -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"    # en producción: https://tu-dominio.com

# --- WhatsApp Business Cloud API (OPCIONAL — ver FASE 8) --------------------
# Solo se usan si cambias business_settings.whatsapp_provider a 'CLOUD_API'
# desde el panel admin. En el modo por defecto ('LINK', enlaces wa.me) puedes
# dejar estas tres variables vacías o sin definir.
WHATSAPP_CLOUD_API_TOKEN=""              # Token de acceso permanente de Meta for Developers
WHATSAPP_CLOUD_API_PHONE_ID=""           # Phone Number ID de tu número de WhatsApp Business
WHATSAPP_CLOUD_API_VERIFY_TOKEN=""       # Token que tú inventas para verificar el webhook

# --- Analítica externa (OPCIONAL — ver FASE 11) -----------------------------
# Si se dejan vacías, el sitio funciona igual — GA4/Meta Pixel son opcionales.
NEXT_PUBLIC_GA4_ID=""             # ej. "G-XXXXXXXXXX"
NEXT_PUBLIC_META_PIXEL_ID=""      # ej. "1234567890123456"

# ============================================================================
# NOTA IMPORTANTE SOBRE WHATSAPP:
# El número de WhatsApp del negocio NO se configura aquí como variable de
# entorno. Vive en la tabla `business_settings` y se administra desde
# /admin/configuracion (ver sección 13 del brief original). Esto permite
# cambiarlo sin redesplegar la aplicación.
# ============================================================================
